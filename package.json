{
  "name": "trifork",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "node scripts/cli.cjs",
    "start": "webpack serve --config webpack.config.cjs --mode development",
    "start:test": "node scripts/serve-static.cjs",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit -p src/tsconfig.app.json && tsc --noEmit -p src/tsconfig.spec.json",
    "test": "npm run typecheck && karma start karma.conf.js --single-run",
    "lint": "tslint --project src/tsconfig.app.json && tslint --project src/tsconfig.spec.json",
    "e2e": "playwright test",
    "test:watch": "node scripts/test-watch.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "4.4.7",
    "@angular/common": "4.4.7",
    "@angular/compiler": "4.4.7",
    "@angular/core": "4.4.7",
    "@angular/forms": "4.4.7",
    "@angular/http": "4.4.7",
    "@angular/material": "2.0.0-beta.6",
    "@angular/platform-browser": "4.4.7",
    "@angular/platform-browser-dynamic": "4.4.7",
    "@angular/router": "4.4.7",
    "core-js": "2.6.12",
    "rxjs": "5.5.12",
    "zone.js": "0.8.29"
  },
  "devDependencies": {
    "@angular/compiler-cli": "4.4.7",
    "@types/jasmine": "2.5.54",
    "@types/node": "6.0.118",
    "@playwright/test": "1.64.1",
    "codelyzer": "3.2.2",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "express": "5.3.0",
    "html-webpack-plugin": "5.6.8",
    "jasmine-core": "2.99.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-jasmine": "5.1.0",
    "karma-webpack": "5.0.1",
    "mini-css-extract-plugin": "2.10.2",
    "reflect-metadata": "0.1.14",
    "sass": "1.106.1",
    "terser-webpack-plugin": "5.6.1",
    "tslint": "5.20.1",
    "typescript": "2.3.4",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.1.0",
    "workbox-webpack-plugin": "7.4.1"
  },
  "engines": {
    "node": "26.12.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@2.6.12": true,
    "fsevents@2.3.3": true
  }
}
